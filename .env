# TCP Bot runtime configuration
# Copy this file only to trusted machines and never commit it.

# Free Fire account used by the bot. Required for bot login.
BOT_UID=7631987291
BOT_PASSWORD=kaddu_uzz7

# Optional region used by the account/login flow.
BOT_REGION=IND

# Control panel listener.
TCP_PANEL_HOST=0.0.0.0
TCP_PANEL_PORT=8080

# Python executable and restart controls.
PYTHON_BIN=python3
RESTART_DELAY_SECONDS=5
BOT_TIMEOUT_SECONDS=1800

# Set to 1 to let start.sh create/update shadmancodex.txt from BOT_UID/BOT_PASSWORD.
WRITE_CREDENTIAL_FILE=1

# Set to 1 to auto-start the bot when the Node control panel starts.
AUTO_START_BOT=0
